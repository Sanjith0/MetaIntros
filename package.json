{
  "name": "queue-up",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm lint && vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "e2e:server": "rm -f prisma/e2e.db* && prisma migrate deploy && pnpm db:seed && next build && next start -p ${E2E_PORT:-3100}",
    "gen:personas": "tsx --tsconfig tsconfig.json scripts/gen-personas.ts",
    "db:seed": "tsx --tsconfig tsconfig.json prisma/seed.ts",
    "ai:warm": "tsx --tsconfig tsconfig.json scripts/warm-ai-cache.ts",
    "images:gen": "tsx --tsconfig tsconfig.json scripts/gen-images.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.json prisma/seed.ts"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
