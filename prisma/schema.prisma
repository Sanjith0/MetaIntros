generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum-like string fields are validated in code by lib/domain/enums.ts (SQLite has no native enums).

/// Key/value runtime settings (demo mode, fill mode, clock offset, AI cache toggle).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model User {
  id             String   @id @default(cuid())
  name           String
  avatarColor    String   @default("#1877f2")
  avatarUrl      String?
  age            Int?
  /// "13-15" | "16-17" | "18-24" | "25+"
  ageBand        String
  /// "woman" | "man" | "nonbinary" | null
  gender         String?
  womenOnlyParty Boolean  @default(false)
  isMe           Boolean  @default(false)
  isSimulated    Boolean  @default(true)
  isLive         Boolean  @default(false)
  homeLat        Float?
  homeLng        Float?
  neighborhood   String?
  /// "seed" | "gps" | "manual"
  locationSource String   @default("seed")
  /// "off" | "friends": whether friends can see the queues you're in (opt-in, default off)
  queueVisibility        String    @default("off")
  /// set the first time we asked, so the queue setup prompt shows once
  queueVisibilityAskedAt DateTime?
  /// Seed cluster label (debug/tests only; never shown to users)
  cluster        String?
  /// Raw Graph-API-shaped payload this user's profile was built from
  rawGraph       Json?
  createdAt      DateTime @default(now())

  tasteProfile     TasteProfile?
  availability     Availability[]
  friendshipsA     Friendship[]    @relation("FriendshipA")
  friendshipsB     Friendship[]    @relation("FriendshipB")
  requestsSent     FriendRequest[] @relation("RequestFrom")
  requestsReceived FriendRequest[] @relation("RequestTo")
  blocksMade       Block[]         @relation("Blocker")
  blocksReceived   Block[]         @relation("Blocked")
  rsvps            EventRsvp[]
  queueEntries     QueueEntry[]
  partyMemberships PartyMember[]
  chatMemberships  ChatMember[]
  messages         ChatMessage[]
  talkCardsOwned   TalkCard[]      @relation("CardOwner")
  talkCardsAbout   TalkCard[]      @relation("CardSubject")
  sessions         DeviceSession[]
  companionBrief   CompanionBrief?
}

model TasteProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ name, category, source }]
  likes        Json
  /// [{ name, category, source }]
  dislikes     Json
  groups       Json
  music        Json
  eventHistory Json
  /// [{ tag, weight }] normalized, non-sensitive interest tags (weight desc)
  interestTags Json
  /// number[]
  embedding    Json
  /// "small-group" | "big-crowd" | "active" | "chill" ...
  socialStyle  String
  updatedAt    DateTime @updatedAt
}

model Availability {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  /// minutes from midnight
  startMin  Int
  endMin    Int

  @@index([userId])
}

model Friendship {
  id           String   @id @default(cuid())
  /// Normalized so userAId < userBId
  userAId      String
  userBId      String
  userA        User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  /// "existing" | "queue_up"
  source       String   @default("existing")
  metAtEventId String?
  metAtEvent   Event?   @relation(fields: [metAtEventId], references: [id], onDelete: SetNull)
  /// Top shared interest surfaced when met through Queue Up
  sharedNote   String?
  createdAt    DateTime @default(now())

  @@unique([userAId, userBId])
}

model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  from      User     @relation("RequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("RequestTo", fields: [toId], references: [id], onDelete: Cascade)
  /// "pending" | "accepted" | "declined"
  status    String   @default("pending")
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromId, toId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Landmark {
  id          String       @id
  name        String
  city        String
  lat         Float
  lng         Float
  description String?
  events      Event[]
  queue       QueueEntry[]
  parties     Party[]
}

model Event {
  id            String    @id @default(cuid())
  title         String
  description   String
  /// string[]
  tags          Json
  startsAt      DateTime
  endsAt        DateTime
  venueName     String
  venueAddress  String
  lat           Float
  lng           Float
  isPublicVenue Boolean   @default(true)
  capacity      Int
  coverColor    String    @default("#1877f2")
  coverPattern  String    @default("dots")
  hostName      String
  landmarkId    String?
  landmark      Landmark? @relation(fields: [landmarkId], references: [id], onDelete: SetNull)
  /// "event" = a real Facebook event · "hangout" = planned by Queue Up for one squad (squad-only, never in the feed)
  kind          String    @default("event")
  createdAt     DateTime  @default(now())

  rsvps        EventRsvp[]
  queueEntries QueueEntry[]
  parties      Party[]
  chats        Chat[]
  friendships  Friendship[]
}

model EventRsvp {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "interested" | "going"
  status    String
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model QueueEntry {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "events" = existing events (eventId set = from that event; null = any event) · "hangout" = plan a new hangout
  mode             String    @default("events")
  /// null = "any event this weekend"
  eventId          String?
  event            Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  targetPartySize  Int       @default(6)
  lat              Float
  lng              Float
  bucketLandmarkId String
  bucketLandmark   Landmark  @relation(fields: [bucketLandmarkId], references: [id])
  /// "waiting" | "matched" | "left"
  status           String    @default("waiting")
  joinedAt         DateTime  @default(now())
  matchedAt        DateTime?
  partyId          String?
  party            Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// snapshot at join: friends can see this queue (see lib/match/queueVisibility.ts)
  visibleToFriends Boolean   @default(false)
  /// set when you joined from a friend's "Queue up too"
  viaFriendId      String?
  /// demo only: a seeded friend's entry the matcher skips until a real person joins the same queue
  parked           Boolean   @default(false)
  /// queuing together: everyone with the same groupId lands in the same squad (never split)
  groupId          String?
  group            QueueGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// "What do you want tonight?" in the person's own words. Only their own Companion sees it.
  tonight          String?

  @@index([status])
}

model Party {
  id         String   @id @default(cuid())
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  landmarkId String
  landmark   Landmark @relation(fields: [landmarkId], references: [id])
  targetSize Int
  ageBand    String
  womenOnly  Boolean  @default(false)
  /// "forming" | "confirming" (ready check: members tap "I'm in") | "confirmed" | "completed" | "cancelled"
  status     String   @default("forming")
  /// Ready-check deadline while status = "confirming"; anyone who hasn't accepted by then is dropped
  acceptBy   DateTime?
  cohesion   Float?
  rationale  String?
  createdAt  DateTime @default(now())

  members        PartyMember[]
  queueEntries   QueueEntry[]
  chat           Chat?
  talkCards      TalkCard[]
  preChats       PreChat[]
  traces         AgentTrace[]
  friendRequests FriendRequest[]
  recaps         CompanionRecap[]
}

model PartyMember {
  id          String    @id @default(cuid())
  partyId     String
  userId      String
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())
  checkedInAt DateTime?
  /// Tapped "I'm in" on the ready check (simulated members accept automatically)
  acceptedAt  DateTime?
  photoOptIn  Boolean   @default(false)
  photoUrl    String?

  @@unique([partyId, userId])
}

model Chat {
  id            String    @id @default(cuid())
  /// "direct" | "group" | "squad"
  type          String
  title         String?
  partyId       String?   @unique
  party         Party?    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  expiresAt     DateTime?
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())

  members  ChatMember[]
  messages ChatMessage[]
}

model ChatMember {
  id         String   @id @default(cuid())
  chatId     String
  userId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([chatId, userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// null for AI host / system messages
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// "user" | "host" | "system"
  kind      String   @default("user")
  body      String
  /// For AI host messages: "live" | "cache" | "mock" | "fallback" (who actually wrote it). null otherwise.
  aiSource  String?
  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

model TalkCard {
  id        String   @id @default(cuid())
  partyId   String
  ownerId   String
  subjectId String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  owner     User     @relation("CardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subject   User     @relation("CardSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  /// { claims: [{ text, source }], openers: string[], pattern?: {...} }
  content   Json
  createdAt DateTime @default(now())

  @@unique([partyId, ownerId, subjectId])
}

model PreChat {
  id         String   @id @default(cuid())
  partyId    String
  party      Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userAId    String
  userBId    String
  /// [{ speaker: "A" | "B", text }]
  transcript Json
  /// string[]
  sparks     Json
  simulated  Boolean  @default(true)
  /// who wrote it: "live" | "cache" | "mock" | "fallback" | "template"
  aiSource   String?
  createdAt  DateTime @default(now())

  @@unique([partyId, userAId, userBId])
}

model AgentTrace {
  id        String   @id @default(cuid())
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// "party_formation" | "event_selection" | "host" | "talk_cards" ...
  agent     String
  stepIndex Int
  /// "tool_call" | "reasoning" | "decision" | "safety_check"
  kind      String
  toolName  String?
  input     Json?
  output    Json?
  summary   String
  createdAt DateTime @default(now())

  @@index([partyId, stepIndex])
}

model DeviceSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

/// Queue together (like a party in a game): 2+ people who enter the queue as one unit. The matcher fills the
/// remaining spots and never splits them. Join by invite (friends) or by short code (anyone who passes safety).
model QueueGroup {
  id              String   @id @default(cuid())
  hostId          String
  /// short join code, unambiguous letters/digits
  code            String   @unique
  /// "open" (gathering) | "queued" | "matched" | "closed"
  status          String   @default("open")
  createdAt       DateTime @default(now())

  members QueueGroupMember[]
  entries QueueEntry[]
}

model QueueGroupMember {
  id          String     @id @default(cuid())
  groupId     String
  group       QueueGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  /// "invited" | "joined" | "declined" | "left"
  status      String     @default("invited")
  invitedById String?
  /// "invite" | "code" | "friend_queue"
  via         String     @default("invite")
  createdAt   DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId, status])
}

// ── Squad album → posts & stories ────────────────────────────────────────────────────────────
// Standalone models: no relation fields were added to User/Party/Event (other work owns those).
// partyId/uploaderId/authorId/eventId are plain ids: every read re-checks membership and existence,
// and purgeSocialOrphans() (lib/server/album.ts) clears rows left behind when a user or squad is deleted.

/// One photo in a squad's shared album. Squad members only; it outlives the squad chat (it's the memory).
model AlbumPhoto {
  id         String      @id @default(cuid())
  partyId    String
  uploaderId String
  /// data:image/(png|jpeg|webp);base64,… (client-resized, server size-capped)
  dataUrl    String
  caption    String?
  /// "Squadmates can include this in a post": the uploader's per-photo consent (default on)
  shareable  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  postPhotos PostPhoto[]

  @@index([partyId, createdAt])
  @@index([uploaderId])
}

/// A feed post or a 24h story. Audience and per-photo consent are enforced in code (lib/server/posts.ts).
model Post {
  id        String      @id @default(cuid())
  authorId  String
  /// "post" | "story"
  kind      String      @default("post")
  caption   String      @default("")
  /// "friends" | "only_me"
  audience  String      @default("friends")
  /// the squad (and its event) this is about: "at <event> with my Queue Up squad"
  partyId   String?
  eventId   String?
  /// when the AI host drafted it: "live" | "cache" | "mock" | "fallback"
  aiSource  String?
  /// the author changed the AI-drafted caption before posting
  aiEdited  Boolean     @default(false)
  createdAt DateTime    @default(now())
  photos    PostPhoto[]

  @@index([authorId, createdAt])
  @@index([partyId])
}

/// Ordered photo references. Deleting an album photo drops it from every post (cascade).
model PostPhoto {
  id       String     @id @default(cuid())
  postId   String
  photoId  String
  position Int
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  photo    AlbumPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([postId, photoId])
  @@index([photoId])
}

/// Each member's answer to "Share the outing" for one squad, so the prompt stops showing.
model ShareChoice {
  id        String   @id @default(cuid())
  partyId   String
  userId    String
  /// "own" | "ai" | "none"
  choice    String
  postId    String?
  createdAt DateTime @default(now())

  @@unique([partyId, userId])
}

// ── Post-event squad ratings ─────────────────────────────────────────────────────────────────
// Standalone models (plain ids, no relation fields on User/Party), like the album above.
// Private by design: a rating is only ever read back by its own rater, or as an anonymous signal in
// matching and event picks. Nobody is shown who rated whom (lib/server/ratings.ts).

/// One member's answer to "How was the night?" after a squad chat ends.
model SquadRating {
  id        String   @id @default(cuid())
  partyId   String
  raterId   String
  eventId   String?
  /// 1–5; null when they tapped "Not now"
  stars     Int?
  /// snapshot of the event's tags (string[]), so learning survives a deleted hangout
  tags      Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partyId, raterId])
  @@index([raterId])
}

/// "Squad up with them again?" for one squadmate. Never shown to the person rated.
model MateRating {
  id        String   @id @default(cuid())
  partyId   String
  raterId   String
  rateeId   String
  /// "again" | "not_again"
  verdict   String
  createdAt DateTime @default(now())

  @@unique([partyId, raterId, rateeId])
  @@index([raterId])
  @@index([rateeId])
}
/// What a user's Companion agent may say about them (share level per fact) plus the model-written parts of the brief.
model CompanionBrief {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// { [factId]: "open" | "need_only" | "private" } — overrides of the defaults
  shares    Json
  /// { depth: { [factId]: string }, communication: string, lightsUp: string[] } written by the Profile Analyst
  generated Json?
  /// what the person told their Companion at check-ins (string[], last few kept; private to their Companion)
  told      Json?
  updatedAt DateTime @updatedAt
}

/// One run of the Companion engine over a set of waiting queue entries.
model MatchRoom {
  id           String   @id @default(cuid())
  /// sorted queue-entry ids, comma-joined
  signature    String
  anchorUserId String
  /// comma-joined user ids in the room (for stage lookups)
  userIds      String
  /// "briefing" | "circles" | "mingling" | "deep" | "deliberating" | "forming" | "group" | "done" | "waiting"
  stage        String
  note         String   @default("")
  /// summary once finished (null while running)
  result       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([anchorUserId])
}

/// What one member sees about how their squad was decided: their conversations, their own
/// Companion's notes, the group conversation, and the similarity-score comparison.
model CompanionRecap {
  id      String @id @default(cuid())
  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId  String
  data    Json

  @@unique([partyId, userId])
}
