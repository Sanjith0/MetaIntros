{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://QUEUEUP_SERVER/api/:path*" },
    { "source": "/images/:path*", "destination": "https://QUEUEUP_SERVER/images/:path*" }
  ]
}
