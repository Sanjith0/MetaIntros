# SQLite file, relative to prisma/
DATABASE_URL="file:./dev.db"

# Muse (Meta Model API, OpenAI-compatible). Leave key empty to run fully from cache/mocks.
MODEL_API_KEY=""
MUSE_BASE_URL="https://api.meta.ai/v1"
MUSE_MODEL="muse-spark-1.1"
# Muse Spark is a reasoning model: hidden reasoning counts against max_tokens.
# MUSE_REASONING_HEADROOM=2000
# MUSE_REASONING_EFFORT=low   # or "none" to omit the parameter
# "cache" = never hit the network; "live" = call Muse on cache miss (needs MODEL_API_KEY).
# Tests ignore this: unit tests force "mock", e2e forces "cache".
AI_MODE="cache"
# Hard cap on live Muse calls per server process. The Companion engine uses about 45 per room of 8 (about 37 once briefs are cached).
# AI_MAX_CALLS=400
# Image model for scripts/gen-images.ts (feed photos, story frames and event covers in public/images).
MUSE_IMAGE_MODEL="muse-image-1.0"
