# SQLite file, relative to prisma/
DATABASE_URL="file:./dev.db"

# Muse (Meta Model API, OpenAI-compatible). Leave key empty to run fully from cache/mocks.
MODEL_API_KEY=""
MUSE_BASE_URL="https://api.meta.ai/v1"
MUSE_MODEL="muse-spark-1.1"
# "cache" = never hit the network; "live" = call Muse on cache miss
AI_MODE="cache"
