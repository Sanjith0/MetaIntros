# Copy to .env.local. Without a key the app runs on the deterministic fallback ("Mock AI" badge).
META_API_BASE_URL=https://api.meta.ai/v1   # confirmed working with LLM_ keys (api.llama.com is not)
META_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_EMBER_MODEL=muse-ember-1.0
# Demo pacing (ms)
DEMO_STEP_DELAY_MS=700
DEMO_FILL_SPACING_MS=450
